import os
from snakemake.utils import min_version

WORKDIR = "/hlilab/gianfranco/pgkmc/workflows/hmn_centromere"
configfile: os.path.join(WORKDIR, "config/config.yaml")
min_version(config["snakemake_min_version"])

hap_list = [l.strip() for l in open(config["hap_list_path"])]
sample_list = [l.strip() for l in open(config["sample_list_path"])]

wildcard_constraints:
    chr = r"chr[0-9XYM]+"

ACRO_PAIRS = {
    "chr13.21": ["chr13", "chr21"],
    "chr14.22": ["chr14", "chr22"],
}
ACRO_SINGLE   = {c for pair in ACRO_PAIRS.values() for c in pair}   # chr13, chr21, chr14, chr22
ACRO_MERGED   = list(ACRO_PAIRS)                                    # chr13.21, chr14.22
NON_ACRO_CHRS = [c for c in config["chroms"] if c not in ACRO_SINGLE]
CENHAP_CHRS   = NON_ACRO_CHRS + ACRO_MERGED
CENHAP_CHR_RE = "|".join(c.replace(".", r"\.") for c in CENHAP_CHRS)
ACRO_PAIR_RE  = "|".join(c.replace(".", r"\.") for c in ACRO_MERGED)

include: "rules/prepare.smk"
include: "rules/cm.smk"

rule all:
    input:
        # expand(
        #     os.path.join(WORKDIR, "results/gtype/centromeres/{sample}/genotype.tsv"),
        #     sample=sample_list
        # )
        expand(
            os.path.join(WORKDIR, "plots/tree_stability/{chr}/bootstrap_tree.png"),
            # chr=CENHAP_CHRS
            chr=config["chroms"]
        )